generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  TRAVELER
  HOST
  ADMIN
}

enum ListingType {
  BEACH_HOUSE
  CABIN
  VILLA
  APARTMENT
  ROOM
  CHALET
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  REFUSED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CASH_DUE
}

enum PaymentMethod {
  CASH
  STRIPE
}

model User {
  id             String         @id @default(cuid())
  name           String
  email          String         @unique
  passwordHash   String?
  image          String?
  phone          String?
  role           Role           @default(TRAVELER)
  bio            String?        @db.Text
  listings       Listing[]      @relation("HostListings")
  bookings       Booking[]
  reviews        Review[]
  favorites      Favorite[]
  sentMessages   Message[]      @relation("SentMessages")
  conversationsAsTraveler Conversation[] @relation("TravelerConversations")
  conversationsAsHost     Conversation[] @relation("HostConversations")
  notifications  Notification[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Listing {
  id            String        @id @default(cuid())
  hostId        String
  host          User          @relation("HostListings", fields: [hostId], references: [id], onDelete: Cascade)
  title         String
  slug          String        @unique
  description   String        @db.Text
  address       String
  city          String
  country       String
  latitude      Decimal       @db.Decimal(10, 7)
  longitude     Decimal       @db.Decimal(10, 7)
  pricePerNight Decimal       @db.Decimal(10, 2)
  serviceFee    Decimal       @default(0) @db.Decimal(10, 2)
  taxes         Decimal       @default(0) @db.Decimal(10, 2)
  type          ListingType
  guests        Int
  bedrooms      Int
  beds          Int
  bathrooms     Int
  houseRules    String        @db.Text
  isPublished   Boolean       @default(true)
  images        ListingImage[]
  categories    ListingCategory[]
  amenities     ListingAmenity[]
  bookings      Booking[]
  reviews       Review[]
  favorites     Favorite[]
  availability  Availability[]
  conversations Conversation[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([city, country])
  @@index([pricePerNight])
}

model ListingImage {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String   @db.Text
  alt       String
  position  Int      @default(0)
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  listings ListingCategory[]
}

model ListingCategory {
  listingId  String
  categoryId String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([listingId, categoryId])
}

model Amenity {
  id       String    @id @default(cuid())
  name     String    @unique
  icon     String?
  listings ListingAmenity[]
}

model ListingAmenity {
  listingId String
  amenityId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([listingId, amenityId])
}

model Booking {
  id          String        @id @default(cuid())
  userId      String
  listingId   String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing     Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  checkIn     DateTime
  checkOut    DateTime
  guests      Int
  nights      Int
  subtotal    Decimal       @db.Decimal(10, 2)
  serviceFee  Decimal       @db.Decimal(10, 2)
  taxes       Decimal       @db.Decimal(10, 2)
  total       Decimal       @db.Decimal(10, 2)
  status      BookingStatus @default(PENDING)
  payment     Payment?
  review      Review?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([checkIn, checkOut])
}

model Payment {
  id             String        @id @default(cuid())
  bookingId      String        @unique
  booking        Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount         Decimal       @db.Decimal(10, 2)
  method         PaymentMethod @default(CASH)
  status         PaymentStatus @default(CASH_DUE)
  providerRef    String?
  createdAt      DateTime      @default(now())
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  bookingId String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String   @db.Text
  createdAt DateTime @default(now())
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
}

model Conversation {
  id         String    @id @default(cuid())
  travelerId String
  hostId     String
  listingId  String?
  traveler   User      @relation("TravelerConversations", fields: [travelerId], references: [id], onDelete: Cascade)
  host       User      @relation("HostConversations", fields: [hostId], references: [id], onDelete: Cascade)
  listing    Listing?  @relation(fields: [listingId], references: [id], onDelete: SetNull)
  messages   Message[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  body           String       @db.Text
  readAt         DateTime?
  createdAt      DateTime     @default(now())
}

model Availability {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  date      DateTime
  isBlocked Boolean  @default(false)
  price     Decimal? @db.Decimal(10, 2)

  @@unique([listingId, date])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
